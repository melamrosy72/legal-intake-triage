PORT=3000
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage
REDIS_URL=redis://localhost:6379
MAX_INQUIRY_CHARS=4000

# LLM provider: "fake" (default, no key needed) or "openrouter"
LLM_PROVIDER=fake
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-openrouter-key-here
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_STRUCTURED_MODE=json_schema
LLM_TIMEOUT_MS=20000
# Reasoning tokens count against this cap, so reasoning models need more than the 800 default.
LLM_MAX_OUTPUT_TOKENS=2000
# Leave empty to omit temperature from the request.
LLM_TEMPERATURE=
# OpenRouter only. Leave empty for non-reasoning models (with require_parameters they would match no endpoint).
LLM_REASONING_EFFORT=low
